import json
import re

log_path = "/home/qwen/.gemini/antigravity-cli/brain/5470a5f6-37c6-4947-83bc-be2e3dc63dd3/.system_generated/logs/transcript_full.jsonl"
lines_dict = {}

with open(log_path, "r", encoding="utf-8") as f:
    for line in f:
        try:
            step = json.loads(line)
            # We want to extract lines from PLANNER_RESPONSE (tool calls) or SYSTEM (tool outputs)
            content = step.get("content", "")
            if not content:
                continue
            
            # Check if this is a view_file output showing lines of index.html
            # In the system response, the content contains the viewed text.
            # Example: "Showing lines 1 to 300\nThe following code has been modified..."
            if "Showing lines" in content and "index.html" in content.lower():
                for match in re.finditer(r"^\s*(\d+):\s(.*)$", content, re.MULTILINE):
                    line_num = int(match.group(1))
                    line_text = match.group(2)
                    lines_dict[line_num] = line_text
        except Exception as e:
            pass

print(f"Extracted {len(lines_dict)} unique lines.")
if lines_dict:
    max_line = max(lines_dict.keys())
    print(f"Max line number: {max_line}")
    gaps = [i for i in range(1, max_line + 1) if i not in lines_dict]
    print(f"Number of missing lines: {len(gaps)}")
    if gaps:
        print(f"Gaps: {gaps}")
        
    # Write the reconstructed file
    reconstructed_text = ""
    for i in range(1, max_line + 1):
        if i in lines_dict:
            reconstructed_text += lines_dict[i] + "\n"
        else:
            reconstructed_text += f"<!-- MISSING LINE {i} -->\n"
            
    with open("ui/index.html.reconstructed", "w", encoding="utf-8") as out:
        out.write(reconstructed_text)
    print("Wrote ui/index.html.reconstructed")
else:
    print("No lines extracted!")

