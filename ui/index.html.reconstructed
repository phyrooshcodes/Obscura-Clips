function detectPlatform(url) {
  if (/youtu\.?be/i.test(url))          return { icon: '▶',  name: 'YouTube'    };
  if (/tiktok/i.test(url))              return { icon: '♪',  name: 'TikTok'     };
  if (/instagram/i.test(url))           return { icon: '◈',  name: 'Instagram'  };
  if (/twitter\.com|x\.com/i.test(url)) return { icon: '✗',  name: 'X / Twitter'};
  if (/vimeo/i.test(url))               return { icon: '▷',  name: 'Vimeo'      };
  if (/facebook/i.test(url))            return { icon: 'f',  name: 'Facebook'   };
  if (/twitch/i.test(url))              return { icon: '🎮', name: 'Twitch'     };
  return { icon: '🌐', name: 'Video URL' };
}

// ── yt-dlp Download Flow ───────────────────────────────────
async function startYtdlDownload() {
  const url = document.getElementById('url-input').value.trim();
  if (!url) return;

  // Lock the UI
  document.getElementById('btn-download-url').disabled = true;
  document.getElementById('btn-download-url').textContent = '⏳ Downloading…';
  document.getElementById('dl-progress').style.display = 'block';
  document.getElementById('dl-log').style.display      = 'block';
  document.getElementById('dl-log').innerHTML          = '';
  document.getElementById('dl-fill').style.width       = '0%';
  document.getElementById('dl-pct').textContent        = '0%';
  document.getElementById('dl-file-ready').classList.remove('visible');
  hideError();

  try {
    // Get a job_id from server
    const res  = await fetch('/prepare-download', { method: 'POST' });
    const data = await res.json();
    const jid  = data.job_id;

    const wsUrl = `ws://localhost:7842/ws-ytdl/${jid}?url=${encodeURIComponent(url)}`;
    const dlWs  = new WebSocket(wsUrl);

    dlWs.onmessage = e => handleYtdlEvent(JSON.parse(e.data), jid);
    dlWs.onerror   = () => showError('Download WebSocket error. Is the server running?');
  } catch(err) {
    showError('Download failed: ' + err.message);
    document.getElementById('btn-download-url').disabled = false;
    document.getElementById('btn-download-url').textContent = '⬇ Download Video';
  }
}

function handleYtdlEvent(ev, jid) {
  switch(ev.type) {

    case 'ytdl_start':
      appendDlLog('Starting yt-dlp download...');
      break;

    case 'ytdl_progress':
      const pct = Math.min(99, ev.percent);
      document.getElementById('dl-fill').style.width  = pct + '%';
      document.getElementById('dl-pct').textContent   = pct.toFixed(1) + '%';
      document.getElementById('dl-speed').textContent = ev.speed  || '—';
      document.getElementById('dl-eta').textContent   = ev.eta    || '—';
      document.getElementById('dl-size').textContent  = ev.size   || '—';
      document.getElementById('dl-label').textContent = 'Downloading…';
      break;

    case 'ytdl_log':
      if (ev.raw) appendDlLog(ev.raw);
      break;

    case 'ytdl_done':
      // Download complete — register job and enable pipeline
      ytdlJobId = jid;
      document.getElementById('dl-fill').style.width  = '100%';
      document.getElementById('dl-pct').textContent   = '100%';
      document.getElementById('dl-label').textContent = 'Download complete!';

      // Show file ready card
      document.getElementById('dl-file-ready').classList.add('visible');
      document.getElementById('dl-ready-name').textContent = ev.filename;
      document.getElementById('dl-ready-meta').textContent = ev.size_mb + ' MB • Ready for pipeline';

      // Update btn-download-url to show success
      document.getElementById('btn-download-url').textContent = '✅ Downloaded — Click Generate Clips below!';
      document.getElementById('btn-download-url').style.background = 'linear-gradient(135deg,#059669,#10b981)';

      // Enable the main generate button
      document.getElementById('btn-generate').disabled = false;
      appendDlLog('✅ Downloaded: ' + ev.filename + ' (' + ev.size_mb + ' MB)');
      break;

    case 'error':
      showError(ev.message);
      document.getElementById('btn-download-url').disabled = false;
      document.getElementById('btn-download-url').textContent = '⬇ Download Video';
      break;
  }
}

function appendDlLog(text) {
  const log = document.getElementById('dl-log');
  log.textContent += text + '\n';
  log.scrollTop = log.scrollHeight;
}

