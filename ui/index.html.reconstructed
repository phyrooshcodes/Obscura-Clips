    list.innerHTML = '';

    if (data.uploads && data.uploads.length > 0) {
      data.uploads.forEach(up => {
        // Clean title for display: remove job_ prefix and clean spacing
        let displayTitle = up.filename
          .replace(/^job_[a-f0-9]{8}\.mp4$/, 'Downloaded Video')
          .replace(/\.mp4$/i, '')
          .replace(/_/g, ' ');
        
