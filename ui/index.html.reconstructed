async function startPipeline() {
  const isUrlMode = !!ytdlJobId;
  hideError();

  try {
    if (isUrlMode) {
      // Video already on server from yt-dlp — skip upload entirely
      jobId = ytdlJobId;
      localStorage.setItem('activeJobId', jobId);
      const filename = document.getElementById('dl-ready-name').textContent || 'video.mp4';
      document.getElementById('proc-filename').textContent = filename;
    } else {
      // Upload the local file first
      btn.textContent = '⏳ Uploading…';
      document.getElementById('upload-progress').style.display = 'block';
      jobId = await uploadFileXHR(selectedFile);
      localStorage.setItem('activeJobId', jobId);
      document.getElementById('proc-filename').textContent = selectedFile.name;
    }

    // Switch to processing panel
    showPanel('panel-processing');
    resetStages();
    clearLog();

    // Open pipeline WebSocket
        const model    = getModel();
    const maxClips = document.getElementById('slider-clips').value;
    const lang     = document.getElementById('lang-input').value.trim();
    const music    = getMusic();
    const captionStyle = document.getElementById('caption-style-select').value;
    const fontPreset = document.getElementById('font-preset-select').value;
    const noTitle = !document.getElementById('title-banner-check').checked;
    const fontName = document.getElementById('custom-font-name').value.trim();
    const fontSize = document.getElementById('slider-font-size').value;
    const primaryColor = document.getElementById('color-primary').value;
    const outlineColor = document.getElementById('color-outline').value;
    const brollEnabled = document.getElementById('broll-toggle').checked;
    const pexelsKey = document.getElementById('pexels-key-input').value.trim();
    const wsUrl    = `ws://localhost:7842/ws/${jobId}?model=${model}&max_clips=${maxClips}&language=${encodeURIComponent(lang)}&music=${music}&caption_style=${captionStyle}&font_preset=${fontPreset}&no_title=${noTitle}&font_name=${encodeURIComponent(fontName)}&font_size=${fontSize}&primary_color=${encodeURIComponent(primaryColor)}&outline_color=${encodeURIComponent(outlineColor)}&broll=${brollEnabled}&pexels_key=${encodeURIComponent(pexelsKey)}`;
    ws = new WebSocket(wsUrl);

    ws.onmessage = e => handleEvent(JSON.parse(e.data));
    ws.onerror   = () => showError('WebSocket connection lost. Is the server running?');
    ws.onclose   = () => {};

  } catch(err) {
    showError((isUrlMode ? 'Pipeline' : 'Upload') + ' failed: ' + err.message);
    btn.disabled = false;
    btn.textContent = '🚀 Generate Clips';
    document.getElementById('upload-progress').style.display = 'none';
  }
}

function uploadFileXHR(file) {
  return new Promise((resolve, reject) => {
    const fd  = new FormData();
    fd.append('file', file);

    const xhr = new XMLHttpRequest();
    xhr.open('POST', '/upload');

    xhr.upload.onprogress = e => {
      if (!e.lengthComputable) return;
      const pct = Math.round((e.loaded / e.total) * 100);
      document.getElementById('upload-pct').textContent = pct + '%';
      document.getElementById('upload-fill').style.width  = pct + '%';
    };

    xhr.onload = () => {
      if (xhr.status === 200) {
        const data = JSON.parse(xhr.responseText);
        resolve(data.job_id);
  });
}

// ── WebSocket event handler ────────────────────────────────
function handleEvent(ev) {
  switch (ev.type) {

    case 'start':
      appendLog('Pipeline started…', 'sub');
      break;

    case 'stage': {
      const s = ev.stage;
      activateStage(s);
      setProgress(STAGE_PCT[s] || 0, STAGE_LABELS[s] || ev.label);
      appendLog('▸ STAGE ' + s + '/6 — ' + ev.label, 'stage');
      break;
    }

    case 'substage':
      appendLog('  [' + ev.substage + '/6] ' + ev.label, 'sub');
      break;

    case 'clip_start':
      clipsTotal = ev.total;
      document.getElementById('clip-counter').classList.add('visible');
      document.getElementById('cc-current').textContent = ev.clip_num - 1;
      document.getElementById('cc-total').textContent   = ev.total;
      appendLog('◆ CLIP ' + ev.clip_num + ' / ' + ev.total, 'clip');
      // Activate stages 4-6 cycling for each clip
      if (ev.clip_num === 1) activateStage(4);
      break;

    case 'clip_ready':
      clipsDone++;
      document.getElementById('cc-current').textContent = clipsDone;
      appendLog('✓ Clip ready → ' + ev.path, 'done');
      break;

    case 'log':
      if (ev.raw && ev.raw.trim()) appendLog(ev.raw, 'log');
      break;

    case 'warning':
      if (ev.raw) appendLog(ev.raw, 'warn');
      break;

    case 'done':
      completeStage(currentStage);
      setProgress(100, 'All done!');
      if (ev.success) {
        setTimeout(() => showResults(ev.clips), 600);
      } else {
        showError('Pipeline finished with errors. Check the log for details.');
        showPanel('panel-upload');
      }
      break;

    case 'error':
      showError(ev.message);
      break;
  }
}

// ── Stage management ───────────────────────────────────────
function resetStages() {
  currentStage = 0; clipsDone = 0; clipsTotal = 0;
  document.getElementById('clip-counter').classList.remove('visible');
  for (let i = 1; i <= 6; i++) {
    const el = document.getElementById('stage-' + i);
    el.classList.remove('active', 'done', 'error');
  }
  setProgress(0, 'Starting pipeline…');
}

function activateStage(n) {
  if (currentStage && currentStage < n) completeStage(currentStage);
  currentStage = n;
  const el = document.getElementById('stage-' + n);
  if (el) el.classList.add('active');
}

function completeStage(n) {
  const el = document.getElementById('stage-' + n);
  if (el) { el.classList.remove('active'); el.classList.add('done'); }
}

function setProgress(pct, label) {
  document.getElementById('pp-fill').style.width = pct + '%';
  document.getElementById('pp-pct').textContent  = pct + '%';
  document.getElementById('pp-label').textContent = label;
}

// ── Log terminal ───────────────────────────────────────────
function appendLog(text, cls = 'log') {
  const out = document.getElementById('log-output');
  const div = document.createElement('div');
  div.className = 'log-line ' + cls;
  // Extract timestamp prefix if present
  const tsMatch = text.match(/^(\d+:\d+:\d+)\s+(INFO|WARNING|ERROR)?\s*(.*)/s);
  if (tsMatch) {
    div.innerHTML = `<span class="log-timestamp">${tsMatch[1]}</span>${escHtml(tsMatch[3])}`;
  } else {
    div.textContent = text;
  }
  out.appendChild(div);
  // Auto-scroll to bottom
  out.scrollTop = out.scrollHeight;
}

function clearLog() {
  document.getElementById('log-output').innerHTML = '';
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ── Results ────────────────────────────────────────────────
function showResults(clips) {
  document.getElementById('result-count').textContent = clips.length;
  const grid = document.getElementById('clips-grid');
  grid.innerHTML = '';

  if (!clips || clips.length === 0) {
    grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1;">
      <div class="empty-icon">📭</div>
      <p>No clips were generated. Check the log for details.</p>
    </div>`;
  } else {
    clips.forEach((clip, i) => {
      const num   = String(i + 1).padStart(2, '0');
      const title = clip.filename
        .replace(/^clip_\d+_/, '')
        .replace(/\.mp4$/i, '')
        .replace(/_/g, ' ');
      grid.innerHTML += `
        <div class="clip-card">
          <div class="clip-num-badge">#${num}</div>
          <div class="clip-video-wrap">
            <video src="${clip.url}" preload="metadata" playsinline></video>
            <div class="play-overlay" onclick="togglePlay(this)">
              <div class="play-btn">▶</div>
            </div>
          </div>
          <div class="clip-info">
            <div class="clip-title" title="${title}">${title}</div>
            <div class="clip-meta">
              <span>${clip.size_mb} MB</span>
              <span class="dot"></span>
              <span>1080×1920</span>
              <span class="dot"></span>
              <span>H.264</span>
            </div>
          </div>
          <div class="clip-actions-row">
            <a class="btn-download" href="${clip.url}" download="${clip.filename}">⬇ Download</a>
            <a class="btn-preview" href="${clip.url}" target="_blank" title="Open in new tab">⛶</a>
          </div>
        </div>
      `;
    });
  }

  showPanel('panel-results');
}

function togglePlay(overlay) {
  const video = overlay.previousElementSibling;
  if (video.paused) {
    video.play();
    overlay.querySelector('.play-btn').textContent = '⏸';
    overlay.style.opacity = '0';
  } else {
    video.pause();
    overlay.querySelector('.play-btn').textContent = '▶';
    overlay.style.opacity = '1';
  }
}

