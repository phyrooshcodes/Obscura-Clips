async function checkNvidiaKey() {
  try {
    const res = await fetch('/api/check-nvidia-key');
    const data = await res.json();
    const badge = document.getElementById('nvidia-status-badge');
    const input = document.getElementById('nvidia-key-input');
    if (data.is_set) {
      badge.innerHTML = '<span style="background: rgba(129,201,149,0.15); color: var(--green); border: 1px solid rgba(129,201,149,0.3); padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 500;">✓ Configured</span>';
      input.value = data.masked_key;
    } else {
      badge.innerHTML = '<span style="background: rgba(242,139,130,0.15); color: var(--red); border: 1px solid rgba(242,139,130,0.3); padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 500;">⚠️ Not Set</span>';
    }
  } catch(e) {
    console.error("Failed to check Nvidia key:", e);
  }
}

async function saveNvidiaKey() {
  const key = document.getElementById('nvidia-key-input').value.trim();
  if (!key) {
    alert("Please enter a key first.");
    return;
  }
  const btn = document.getElementById('btn-save-nvidia');
  const origText = btn.textContent;
  btn.textContent = "Saving...";
  btn.disabled = true;
  
  try {
    const res = await fetch('/api/save-nvidia-key', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key })
    });
    const data = await res.json();
    if (data.success) {
      alert("NVIDIA API Key saved permanently!");
      checkNvidiaKey();
    } else {
      alert("Failed: " + data.message);
    }
  } catch(e) {
    alert("Network error: " + e.message);
  } finally {
    btn.textContent = origText;
    btn.disabled = false;
  }
}

